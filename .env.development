# Dev defaults: the browser calls /api and /ws on the Vite dev server, which
# proxies them to DEV_PROXY_TARGET. Same origin means no CORS setup and a
# first-party refresh cookie.
# Put personal overrides in `.env.development.local` (git-ignored), e.g.:
#   DEV_PROXY_TARGET=http://localhost:4000
VITE_API_BASE_URL=/api
VITE_WS_URL=/ws

# Dev server only (not exposed to the browser bundle).
DEV_PROXY_TARGET=http://localhost:3000
# Extra hostnames the dev server should answer to, comma-separated (e.g. `.app.github.dev` for Codespaces).
DEV_ALLOWED_HOSTS=
