# Dev defaults: mock mode, so the UI runs without a backend.
# To use your real API, create `.env.development.local` (git-ignored) with:
#   VITE_USE_MOCKS=false
# Requests then go to /api and /ws on the dev server, which proxies them to DEV_PROXY_TARGET.
VITE_API_BASE_URL=/api
VITE_WS_URL=/ws
VITE_USE_MOCKS=true

# Dev server only (not exposed to the browser bundle).
DEV_PROXY_TARGET=http://localhost:3000
# Extra hostnames the dev server should answer to, comma-separated (e.g. `.app.github.dev` for Codespaces).
DEV_ALLOWED_HOSTS=
