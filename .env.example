# Base URL of the REST API (no trailing slash). Every endpoint in docs/API_CONTRACT.md is relative to this.
# A path like /api is resolved against the page's origin.
VITE_API_BASE_URL=https://api.example.com/api

# WebSocket endpoint for realtime events. A path like /ws is resolved against the page's origin (ws:// or wss://).
VITE_WS_URL=wss://api.example.com/ws

# true  → in-memory fixtures and a fake socket (no backend needed)
# false → talk to VITE_API_BASE_URL / VITE_WS_URL
VITE_USE_MOCKS=false

# Dev server only: where /api and /ws are proxied, and extra allowed hostnames (comma-separated).
DEV_PROXY_TARGET=http://localhost:3000
DEV_ALLOWED_HOSTS=
